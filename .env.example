# Hugging Face token, used only for deployment (pushing to Spaces).
# The local application runs with no token at all.
HF_TOKEN=

# Optional. Only needed if you pick the "Fast cloud, Groq" model in the UI.
# Get a free key at https://console.groq.com -> API Keys. Read only from the
# environment, never committed. Leave empty to stay fully local.
GROQ_API_KEY=
